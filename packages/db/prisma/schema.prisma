// Analiva Automation Hub — data model (Phase 0 + 1).
//
// Rules (CLAUDE.md §6):
// - Every tenant-owned table has practiceId; client-owned tables also have clientId.
//   Queries go through `tenantDb(ctx)` which enforces this (packages/core/src/tenancy.ts).
// - Money is BigInt minor units (cents) with a currency. Never floats.
// - Original documents (Document) and extracted data (Invoice) are separate rows,
//   linked, with a record of who/what extracted it.
// - Soft delete (deletedAt) where records matter legally. Invoices retained >= 5 years.
// - All timestamps UTC; the UI displays Africa/Johannesburg.
//
// Hosted on Supabase Postgres. Every table has RLS enabled with no policies, so the
// public PostgREST API (anon / authenticated keys) can read nothing; the app connects
// as the table owner through Prisma. See migrations/*_rls_and_search.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
  CLIENT
  CLIENT_STAFF
}

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ServiceType {
  ACCOUNTING
  PAYROLL
  CIPC
  BRANDING
  WEBSITE
  LAUNCH
}

enum InvoiceDirection {
  // Supplier bill received by the client
  PAYABLE
  // Invoice issued by the client to its customer
  RECEIVABLE
}

enum InvoiceStatus {
  CAPTURED
  NEEDS_REVIEW
  APPROVED
  POSTED
  REJECTED
}

enum CaptureSource {
  MANUAL
  AI
  IMPORT
  API
  EMAIL
}

enum EmailKind {
  INVOICE
  STATEMENT
  CIPC
  QUERY
  OTHER
}

enum CaptureStatus {
  NEEDS_CLIENT
  NEEDS_REVIEW
  SUGGESTED
  FILED
  DISMISSED
  FAILED
}

enum DocumentKind {
  INVOICE
  STATEMENT
  CIPC
  CONTRACT
  MANDATE
  BRAND_ASSET
  PAYROLL
  TAX
  OTHER
}

enum DocumentSource {
  UPLOAD
  EMAIL
  PORTAL
  API
}

enum MailProvider {
  IMAP_SMTP
  MICROSOFT_365
  GMAIL
}

enum MailPurpose {
  INBOUND
  OUTBOUND
  BOTH
}

enum ConnectionStatus {
  UNTESTED
  OK
  ERROR
}

enum CaptureMode {
  /// Every invoice waits for a person
  ALWAYS_REVIEW
  /// File automatically at or above the client's confidence threshold
  AUTO_WHEN_CONFIDENT
  /// Never review: file everything once the client is known and the basics were read
  NEVER_REVIEW
}

enum LedgerAccountType {
  BANK
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  SALES
  OTHER_INCOME
  COST_OF_SALES
  EXPENSE
  INCOME_TAX
}

enum JournalSource {
  INVOICE
  PAYMENT
  BANK
  MANUAL
  OPENING
  REVERSAL
}

enum BankTxnStatus {
  UNMATCHED
  CODED
  MATCHED
  IGNORED
}

enum RuleDirection {
  IN
  OUT
  ANY
}

enum ActorType {
  USER
  SYSTEM
  API_KEY
}

model Practice {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  vatNumber          String?
  registrationNumber String?
  email              String?
  phone              String?
  website            String?
  physicalAddress    String?
  timezone           String   @default("Africa/Johannesburg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  clients     Client[]
  contacts    Contact[]
  workspaces  Workspace[]
  services    ClientService[]
  mandates    Mandate[]
  suppliers   Supplier[]
  invoices    Invoice[]
  lines       InvoiceLine[]
  documents   Document[]
  auditLogs   AuditLog[]
  mailAccounts MailAccount[]
  emails       EmailMessage[]
  captures     Capture[]
  senderRules  SenderRule[]
  supplierProfiles SupplierProfile[]
  corrections  CaptureCorrection[]
  ledgerAccounts LedgerAccount[]
  journals     JournalEntry[]
  journalLines JournalLine[]
  bankAccounts BankAccount[]
  bankTransactions BankTransaction[]
  bankRules    BankRule[]
  filings      ComplianceFiling[]
}

model User {
  id         String    @id @default(cuid())
  practiceId String
  /// Supabase auth.users.id
  authUserId String    @unique @db.Uuid
  email      String
  name       String
  role       UserRole
  /// Set for CLIENT and CLIENT_STAFF
  clientId   String?
  disabledAt DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client?  @relation(fields: [clientId], references: [id])

  uploadedDocuments Document[] @relation("DocumentUploader")
  capturedInvoices  Invoice[]  @relation("InvoiceCapturer")

  @@unique([practiceId, email])
  @@index([clientId])
}

model Client {
  id                 String       @id @default(cuid())
  practiceId         String
  /// Human-friendly reference, e.g. CL-0042. Unique per practice.
  code               String
  name               String
  tradingName        String?
  /// CIPC registration, canonical form 2019/123456/07
  registrationNumber String?
  vatNumber          String?
  taxNumber          String?
  email              String?
  phone              String?
  /// Email domains used for matching inbound mail, lowercase
  emailDomains       String[]     @default([])
  status             ClientStatus @default(ONBOARDING)
  notes              String?
  // Capture automation (owner-controlled)
  captureMode        CaptureMode  @default(AUTO_WHEN_CONFIDENT)
  /// 0..1; used with AUTO_WHEN_CONFIDENT
  autoFileThreshold  Float        @default(0.9)
  // Tax profile: drives VAT treatment and the compliance calendar
  isCompany          Boolean      @default(true)
  vatRegistered      Boolean      @default(false)
  /// A, B or C (SARS VAT category)
  vatCategory        String?
  payeRegistered     Boolean      @default(false)
  /// 1-12, month the financial year ends
  financialYearEndMonth Int       @default(2)
  incorporationDate  DateTime?    @db.Date
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  practice  Practice        @relation(fields: [practiceId], references: [id])
  users     User[]
  contacts  Contact[]
  workspace Workspace?
  services  ClientService[]
  mandates  Mandate[]
  suppliers Supplier[]
  invoices  Invoice[]
  lines     InvoiceLine[]
  documents Document[]
  emails    EmailMessage[]
  captures  Capture[]
  senderRules SenderRule[]
  ledgerAccounts LedgerAccount[]
  journals  JournalEntry[]
  journalLines JournalLine[]
  bankAccounts BankAccount[]
  bankTransactions BankTransaction[]
  bankRules BankRule[]
  filings   ComplianceFiling[]

  @@unique([practiceId, code])
  @@index([practiceId, status])
  @@index([practiceId, registrationNumber])
  @@index([practiceId, vatNumber])
  @@index([practiceId, phone])
}

model Contact {
  id         String   @id @default(cuid())
  practiceId String
  clientId   String
  name       String
  email      String?
  phone      String?
  position   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([practiceId, email])
  @@index([practiceId, phone])
  @@index([clientId])
}

/// Per-client space: branding and portal settings. Services live in ClientService.
model Workspace {
  id           String   @id @default(cuid())
  practiceId   String
  clientId     String   @unique
  brandPrimary String?
  brandAccent  String?
  logoDocumentId String?
  emailFooter  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientService {
  id         String      @id @default(cuid())
  practiceId String
  clientId   String
  service    ServiceType
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, service])
  @@index([practiceId])
}

/// Signed authority to send email in the client's name. Outbound mail (Phase 3)
/// is refused without a valid, unexpired, unrevoked mandate.
model Mandate {
  id          String    @id @default(cuid())
  practiceId  String
  clientId    String
  scope       String
  signedBy    String
  signedAt    DateTime
  expiresAt   DateTime?
  revokedAt   DateTime?
  documentId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  practice Practice  @relation(fields: [practiceId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])

  @@index([clientId])
  @@index([practiceId])
}

/// A supplier in a client's books.
model Supplier {
  id         String    @id @default(cuid())
  practiceId String
  clientId   String
  name       String
  vatNumber  String?
  email      String?
  phone      String?
  /// Learned: the ledger account this supplier's bills go to
  defaultAccountCode String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  practice Practice  @relation(fields: [practiceId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  invoices Invoice[]

  @@unique([clientId, name])
  @@index([practiceId, vatNumber])
}

model Invoice {
  id                    String           @id @default(cuid())
  practiceId            String
  clientId              String
  supplierId            String?
  direction             InvoiceDirection @default(PAYABLE)
  invoiceNumber         String
  /// Uppercase alphanumerics only; used for search and duplicate detection
  invoiceNumberNorm     String
  issueDate             DateTime         @db.Date
  dueDate               DateTime?        @db.Date
  currency              String           @default("ZAR") @db.Char(3)
  subtotalCents         BigInt
  vatCents              BigInt
  totalCents            BigInt
  status                InvoiceStatus    @default(CAPTURED)
  description           String?
  /// Ledger account the bill is expensed to (or sales account), by code
  accountCode           String?
  amountPaidCents       BigInt           @default(0)
  journalEntryId        String?          @unique
  /// 0..1 extraction confidence; null for manual capture
  confidence            Float?
  /// Validation issue codes from @aah/core validateInvoiceTotals
  validationIssues      String[]         @default([])
  // Provenance: the original document and who or what extracted these fields
  sourceDocumentId      String?
  captureSource         CaptureSource    @default(MANUAL)
  capturedByUserId      String?
  capturedAt            DateTime         @default(now())
  /// Earliest date this record may be purged (>= 5 years)
  retainUntil           DateTime
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  practice       Practice      @relation(fields: [practiceId], references: [id])
  client         Client        @relation(fields: [clientId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id])
  capturedBy     User?         @relation("InvoiceCapturer", fields: [capturedByUserId], references: [id])
  lines          InvoiceLine[]
  capture        Capture?
  journal        JournalEntry?     @relation("InvoiceJournal", fields: [journalEntryId], references: [id])
  bankMatches    BankTransaction[]

  @@index([practiceId, invoiceNumberNorm])
  @@index([practiceId, totalCents])
  @@index([practiceId, issueDate])
  @@index([clientId, issueDate])
  @@index([supplierId, invoiceNumberNorm])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  practiceId     String
  clientId       String
  invoiceId      String
  position       Int
  description    String
  quantity       Decimal @db.Decimal(14, 4)
  unitPriceCents BigInt
  /// Basis points, 1500 = 15%
  vatRateBps     Int     @default(1500)
  lineTotalCents BigInt
  accountCode    String?

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// An original file exactly as received. Extracted data lives elsewhere and links here.
model Document {
  id               String         @id @default(cuid())
  practiceId       String
  /// Null for practice-level documents (never visible to client roles)
  clientId         String?
  kind             DocumentKind   @default(OTHER)
  source           DocumentSource @default(UPLOAD)
  filename         String
  mimeType         String
  sizeBytes        Int
  /// Path inside the private Supabase Storage bucket
  storagePath      String         @unique
  sha256           String
  uploadedByUserId String?
  /// Set when the file arrived as an email attachment
  emailMessageId   String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())

  practice   Practice  @relation(fields: [practiceId], references: [id])
  client     Client?   @relation(fields: [clientId], references: [id])
  uploadedBy User?     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  email      EmailMessage? @relation(fields: [emailMessageId], references: [id])
  invoices   Invoice[]
  mandates   Mandate[]
  captures   Capture[]

  @@index([practiceId, sha256])
  @@index([clientId, createdAt])
}

/// Append-only. Who, what, when and why for every action.
model AuditLog {
  id         String    @id @default(cuid())
  practiceId String
  clientId   String?
  actorType  ActorType
  actorId    String?
  actorLabel String?
  action     String
  entityType String
  entityId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])

  @@index([practiceId, createdAt])
  @@index([practiceId, entityType, entityId])
  @@index([clientId, createdAt])
}

/// A mailbox the practice connects: watched for inbound mail (Phase 2) and/or used to
/// send (Phase 3). The password is AES-256-GCM encrypted with SECRETS_KEY and never
/// returned to the browser.
model MailAccount {
  id               String           @id @default(cuid())
  practiceId       String
  label            String
  emailAddress     String
  displayName      String?
  provider         MailProvider     @default(IMAP_SMTP)
  purpose          MailPurpose      @default(BOTH)
  username         String
  secretEncrypted  String?
  imapHost         String?
  imapPort         Int?             @default(993)
  imapSecure       Boolean          @default(true)
  imapFolder       String           @default("INBOX")
  smtpHost         String?
  smtpPort         Int?             @default(465)
  smtpSecure       Boolean          @default(true)
  isDefaultSender  Boolean          @default(false)
  enabled          Boolean          @default(true)
  status           ConnectionStatus @default(UNTESTED)
  lastTestedAt     DateTime?
  lastError        String?
  // Inbox polling state (IMAP UIDs are only meaningful within a UIDVALIDITY)
  uidValidity      String?
  lastUid          Int?
  lastPolledAt     DateTime?
  lastPollError    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  practice Practice       @relation(fields: [practiceId], references: [id])
  emails   EmailMessage[]

  @@unique([practiceId, emailAddress])
}

/// An email fetched from a connected mailbox. The raw .eml is kept in storage.
model EmailMessage {
  id              String    @id @default(cuid())
  practiceId      String
  /// Matched client, if any
  clientId        String?
  mailAccountId   String
  messageId       String
  imapUid         Int
  fromAddress     String
  fromName        String?
  toAddresses     String[]  @default([])
  subject         String
  receivedAt      DateTime
  textPreview     String?
  kind            EmailKind @default(OTHER)
  kindReason      String?
  /// MATCHED | AMBIGUOUS | UNMATCHED
  matchStatus     String
  matchCandidates Json?
  rawStoragePath  String?
  createdAt       DateTime  @default(now())

  practice    Practice    @relation(fields: [practiceId], references: [id])
  client      Client?     @relation(fields: [clientId], references: [id])
  mailAccount MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  documents   Document[]
  captures    Capture[]

  @@unique([mailAccountId, messageId])
  @@index([practiceId, receivedAt])
}

/// One invoice-like document waiting to be (or already) filed. Holds what the
/// rules extracted, separate from the Invoice created from it.
model Capture {
  id              String        @id @default(cuid())
  practiceId      String
  clientId        String?
  emailMessageId  String?
  documentId      String
  status          CaptureStatus
  confidence      Float
  /// { field: { value, confidence, source } }; amounts as cent strings, dates as YYYY-MM-DD
  extracted       Json
  /// Text the rules read, kept so corrections can teach supplier labels
  documentText    String?
  issues          String[]      @default([])
  note            String?
  invoiceId       String?       @unique
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  practice    Practice            @relation(fields: [practiceId], references: [id])
  client      Client?             @relation(fields: [clientId], references: [id])
  email       EmailMessage?       @relation(fields: [emailMessageId], references: [id])
  document    Document            @relation(fields: [documentId], references: [id])
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id])
  corrections CaptureCorrection[]

  @@index([practiceId, status])
}

/// Learned: mail from this address or @domain belongs to this client.
model SenderRule {
  id              String   @id @default(cuid())
  practiceId      String
  pattern         String
  clientId        String
  createdByUserId String?
  createdAt       DateTime @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([practiceId, pattern])
}

/// Learned per supplier (keyed by VAT number or @sender-domain): its name and the
/// labels its invoices use, so the next invoice reads with higher confidence.
model SupplierProfile {
  id           String   @id @default(cuid())
  practiceId   String
  key          String
  supplierName String
  vatNumber    String?
  /// { invoiceNumber: ["doc ref"], total: ["payable now"], ... }
  labels       Json     @default("{}")
  timesFiled   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])

  @@unique([practiceId, key])
}

/// Every user correction to an extracted field (CLAUDE.md §7).
model CaptureCorrection {
  id             String   @id @default(cuid())
  practiceId     String
  captureId      String
  field          String
  extractedValue String?
  correctedValue String?
  learnedLabel   String?
  userId         String?
  createdAt      DateTime @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])
  capture  Capture  @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@index([practiceId, createdAt])
}

/// A client's chart of accounts.
model LedgerAccount {
  id         String            @id @default(cuid())
  practiceId String
  clientId   String
  code       String
  name       String
  type       LedgerAccountType
  /// Role the posting engine looks up (VAT_INPUT, CREDITORS, ...)
  systemKey  String?
  keywords   String[]          @default([])
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  practice     Practice      @relation(fields: [practiceId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines        JournalLine[]
  bankAccounts BankAccount[]

  @@unique([clientId, code])
  @@index([clientId, systemKey])
}

/// A balanced double-entry journal. Never edited: corrections are reversals.
model JournalEntry {
  id             String        @id @default(cuid())
  practiceId     String
  clientId       String
  date           DateTime      @db.Date
  reference      String?
  description    String
  source         JournalSource
  /// Invoice / bank transaction / journal this came from
  sourceId       String?
  reversesId     String?       @unique
  postedByUserId String?
  createdAt      DateTime      @default(now())

  practice   Practice      @relation(fields: [practiceId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines      JournalLine[]
  invoice    Invoice?      @relation("InvoiceJournal")
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")

  @@index([clientId, date])
  @@index([clientId, source, sourceId])
}

model JournalLine {
  id          String   @id @default(cuid())
  practiceId  String
  clientId    String
  entryId     String
  accountId   String
  /// Copied from the entry so reports can filter lines by date directly
  date        DateTime @db.Date
  debitCents  BigInt   @default(0)
  creditCents BigInt   @default(0)
  description String?

  practice Practice      @relation(fields: [practiceId], references: [id])
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entry    JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account  LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([clientId, date])
  @@index([accountId, date])
}

model BankAccount {
  id              String   @id @default(cuid())
  practiceId      String
  clientId        String
  name            String
  bankName        String?
  /// Last 4 digits only
  accountLast4    String?
  ledgerAccountId String
  createdAt       DateTime @default(now())

  practice      Practice          @relation(fields: [practiceId], references: [id])
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])
  transactions  BankTransaction[]
}

model BankTransaction {
  id             String        @id @default(cuid())
  practiceId     String
  clientId       String
  bankAccountId  String
  date           DateTime      @db.Date
  description    String
  /// Signed from the bank's view: positive = money in
  amountCents    BigInt
  balanceCents   BigInt?
  fingerprint    String
  status         BankTxnStatus @default(UNMATCHED)
  /// Account it was coded to (CODED)
  accountCode    String?
  vatInclusive   Boolean       @default(false)
  /// Invoice it settles (MATCHED)
  invoiceId      String?
  journalEntryId String?
  ruleId         String?
  matchReason    String?
  importBatch    String?
  createdAt      DateTime      @default(now())

  practice    Practice    @relation(fields: [practiceId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  rule        BankRule?   @relation(fields: [ruleId], references: [id])

  @@unique([bankAccountId, fingerprint])
  @@index([clientId, status])
  @@index([clientId, date])
}

/// "Lines containing X go to account Y". Client-specific, or practice-wide when clientId is null.
model BankRule {
  id           String        @id @default(cuid())
  practiceId   String
  clientId     String?
  matchText    String
  direction    RuleDirection @default(ANY)
  accountCode  String
  vatInclusive Boolean       @default(false)
  timesApplied Int           @default(0)
  createdAt    DateTime      @default(now())

  practice     Practice          @relation(fields: [practiceId], references: [id])
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([practiceId, clientId])
}

/// A statutory return marked as done (deadlines themselves are calculated).
model ComplianceFiling {
  id                String   @id @default(cuid())
  practiceId        String
  clientId          String
  /// e.g. VAT201:2026-08
  periodKey         String
  completedAt       DateTime @default(now())
  completedByUserId String?
  note              String?

  practice Practice @relation(fields: [practiceId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, periodKey])
}
