# Copy to .env (repo root) for local dev and set the same values in Vercel.
# Never commit real values.

# Supabase Postgres
# Pooled (transaction pooler, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
# Direct / session (port 5432) — used by migrations.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only. Used for storage uploads and admin user creation.
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket for original documents (private)
DOCUMENTS_BUCKET="documents"

# Two-step login: "true" forces staff and clients to enrol an authenticator app.
REQUIRE_MFA="true"

# Public base URL (used in auth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32 random bytes, base64. Encrypts stored mailbox passwords. Changing it makes saved passwords unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=""

# Shared secret Supabase pg_cron sends to /api/cron/poll-inbox (Authorization: Bearer ...).
CRON_SECRET=""
